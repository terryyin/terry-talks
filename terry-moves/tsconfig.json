{
	"compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
		"target": "ES2022",
		"module": "commonjs",
		"jsx": "react-jsx",
		"outDir": "./dist",
		"strict": true,
		"noEmit": true,
		"lib": ["ES2022", "DOM"],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true
	}
}
