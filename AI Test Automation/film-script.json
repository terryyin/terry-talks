    {
      "id": "selective",
      "label": "Regained control, intent-first development",
      "captionRanges": [
        {"text": "Regain control. Turn useful checks into test code.", "spoken": "Once you regain control, turn useful checks into test code.", "speechStart": 56.389999084472656, "speechEnd": 59.549998931884765, "wordCues": {"once": 56.389999084472656, "you": 56.6899983215332, "regain": 56.810001068115234, "control": 57.08999984741211, "turn": 58.11000030517578, "useful": 58.13000076293945, "checks": 58.51000183105469, "into": 58.72999923706055, "test": 58.990001373291015, "code": 59.310001068115234}, "start": 56.0, "end": 59.9},
        {"text": "No AI needed to run it.", "spoken": "No AI needed to run it.", "speechStart": 60.24999969482422, "speechEnd": 61.56999938964844, "wordCues": {"no": 60.24999969482422, "ai": 60.40999954223633, "needed": 60.6899983215332, "to": 60.95000045776367, "run": 61.209998779296875, "it": 61.27000015258789}, "start": 59.9, "end": 61.733333333333334},
        {"text": "New features: express intent in tests first.", "spoken": "For new features, express intent in tests first.", "speechStart": 61.93, "speechEnd": 64.15000122070312, "wordCues": {"for": 61.93, "new": 61.990001373291015, "features": 62.1700016784668, "express": 62.6700016784668, "intent": 62.90999954223633, "in": 63.22999923706055, "tests": 63.52999847412109, "first": 63.74999969482422}, "start": 61.733333333333334, "end": 64.46666666666667},
        {"text": "Let tests drive development.", "spoken": "Let them drive development.", "speechStart": 64.79000061035156, "speechEnd": 65.66999786376952, "wordCues": {"let": 64.79000061035156, "them": 64.8300015258789, "drive": 64.97000091552734, "development": 65.24999969482421}, "start": 64.46666666666667, "end": 66.03333333333333}
      ],
