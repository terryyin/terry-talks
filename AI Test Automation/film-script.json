    {
      "id": "purpose",
      "label": "Purpose and proof",
      "captionRanges": [
        {"text": "What should the code do? PURPOSE.", "spoken": "Tests define what your code should do: purpose.", "speechStart": 12.380000190734863, "speechEnd": 14.319999771118164, "wordCues": {"tests": 12.380000190734863, "define": 12.380000190734863, "what": 12.760000305175781, "your": 12.899999694824219, "code": 13.059999542236328, "should": 13.220000343322754, "do": 13.42000015258789, "purpose": 14.319999771118164}, "start": 11.966666666666667, "end": 14.566666666666666},
        {"text": "Does it do it? PROOF.", "spoken": "And show whether it does: proof.", "speechStart": 14.800000267028809, "speechEnd": 16.44000061035156, "wordCues": {"and": 14.800000267028809, "show": 14.960000114440918, "whether": 15.1400004196167, "it": 15.340000228881836, "does": 15.479999618530274, "proof": 16.44000061035156}, "start": 14.566666666666666, "end": 16.6}
      ],
      "start": 11.966666666666667,
      "end": 16.6,
      "duration": 4.633333333333335
    },
    {
      "id": "upkeep",
      "label": "Protection has an engineering cost",
      "captionRanges": [
        {"text": "But first, they’re more code.", "spoken": "But first, they’re more code.", "speechStart": 16.78000076293945, "speechEnd": 18.58, "wordCues": {"but": 16.78000076293945, "first": 17.239999847412108, "theyre": 17.680000381469725, "more": 18.10000045776367, "code": 18.29999931335449}, "start": 16.6, "end": 19.0},
        {"text": "High-level engineering. Preserve the original intent.", "spoken": "Test automation requires high-level software engineering—and must preserve the original intent.", "speechStart": 19.42000015258789, "speechEnd": 23.899999694824217, "wordCues": {"test": 19.42000015258789, "automation": 19.47999961853027, "requires": 19.879999237060545, "high": 20.379999237060545, "level": 20.700000839233397, "software": 20.879999237060545, "engineering": 21.28000076293945, "and": 21.680000381469725, "must": 22.399999694824217, "preserve": 22.620000915527342, "the": 22.97999961853027, "original": 23.539999084472655, "intent": 23.539999084472655}, "start": 19.0, "end": 24.3},
        {"text": "Complexity can arrive before protection.", "spoken": "AI can pile on complexity before providing protection.", "speechStart": 24.719999389648436, "speechEnd": 27.399999694824217, "wordCues": {"ai": 24.719999389648436, "can": 24.97999961853027, "pile": 25.29999931335449, "on": 25.4599991607666, "complexity": 26.13999946594238, "before": 26.13999946594238, "providing": 26.539999084472655, "protection": 26.94000061035156}, "start": 24.3, "end": 27.7}
      ],
      "start": 16.6,
