    {
      "id": "selective",
      "label": "Regained control, intent-first development",
      "captionRanges": [
        {"text": "Regain control. Turn useful checks into test code.", "spoken": "Once you regain control, turn useful checks into test code.", "speechStart": 56.039999084472655, "speechEnd": 59.199998931884764, "wordCues": {"once": 56.039999084472655, "you": 56.3399983215332, "regain": 56.46000106811523, "control": 56.73999984741211, "turn": 57.76000030517578, "useful": 57.78000076293945, "checks": 58.160001831054686, "into": 58.379999237060545, "test": 58.640001373291014, "code": 58.96000106811523}, "start": 55.7, "end": 59.53333333333333},
        {"text": "No AI needed to run it.", "spoken": "No AI needed to run it.", "speechStart": 59.89999969482422, "speechEnd": 61.219999389648436, "wordCues": {"no": 59.89999969482422, "ai": 60.059999542236326, "needed": 60.3399983215332, "to": 60.60000045776367, "run": 60.85999877929687, "it": 60.92000015258789}, "start": 59.53333333333333, "end": 61.4},
        {"text": "New features: express intent in tests first.", "spoken": "For new features, express intent in tests first.", "speechStart": 61.58, "speechEnd": 63.80000122070312, "wordCues": {"for": 61.58, "new": 61.640001373291014, "features": 61.820001678466795, "express": 62.320001678466795, "intent": 62.559999542236326, "in": 62.879999237060545, "tests": 63.17999847412109, "first": 63.39999969482422}, "start": 61.4, "end": 64.13333333333334},
        {"text": "Let tests drive development.", "spoken": "Let them drive development.", "speechStart": 64.44000061035156, "speechEnd": 65.31999786376953, "wordCues": {"let": 64.44000061035156, "them": 64.4800015258789, "drive": 64.62000091552734, "development": 64.89999969482422}, "start": 64.13333333333334, "end": 65.66666666666667}
