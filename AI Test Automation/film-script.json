        {"text": "Confirm fixes. Explore for bugs.", "spoken": "confirm fixes, explore for bugs,", "speechStart": 45.39999969482422, "speechEnd": 47.3399983215332, "wordCues": {"confirm": 45.39999969482422, "fixes": 45.62000091552734, "explore": 46.820001678466795, "for": 46.820001678466795, "bugs": 47.3399983215332}, "start": 45.06666666666667, "end": 47.43333333333333},
        {"text": "Does known behavior still work?", "spoken": "and check that known behavior still works.", "speechStart": 47.539999084472655, "speechEnd": 49.44000061035156, "wordCues": {"and": 47.539999084472655, "check": 47.980001525878905, "that": 48.08, "known": 48.35999877929687, "behavior": 48.51999862670898, "still": 48.8399983215332, "works": 49.23999984741211}, "start": 47.43333333333333, "end": 49.7},
        {"text": "It’s a compromise.", "spoken": "It’s a compromise.", "speechStart": 49.96000106811523, "speechEnd": 50.89999969482422, "wordCues": {"its": 49.96000106811523, "a": 50.3399983215332, "compromise": 50.89999969482422}, "start": 49.7, "end": 51.06666666666667},
        {"text": "A system in panic needs relief.", "spoken": "But a system already in panic needs relief—", "speechStart": 51.219999389648436, "speechEnd": 53.46000106811523, "wordCues": {"but": 51.219999389648436, "a": 51.49999816894531, "system": 51.719999389648436, "already": 51.92000015258789, "in": 52.379999237060545, "panic": 52.820001678466795, "needs": 52.820001678466795, "relief": 53.10000045776367}, "start": 51.06666666666667, "end": 53.733333333333334},
        {"text": "No more test code to maintain.", "spoken": "not more test code to maintain.", "speechStart": 53.99999816894531, "speechEnd": 55.379999237060545, "wordCues": {"not": 53.99999816894531, "more": 54.219999389648436, "test": 54.42000015258789, "code": 54.719999389648436, "to": 54.8399983215332, "maintain": 55.379999237060545}, "start": 53.733333333333334, "end": 55.7}
