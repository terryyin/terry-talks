    {
      "id": "sandbox",
      "label": "AI performs hands-on testing",
      "captionRanges": [
        {"text": "A better use of AI here? Hands-on testing.", "spoken": "A better use of AI here? Hands-on testing.", "speechStart": 33.980001525878905, "speechEnd": 36.46000106811523, "wordCues": {"a": 33.980001525878905, "better": 34.059999542236326, "use": 34.30000122070312, "of": 34.51999862670898, "ai": 34.699998931884764, "here": 34.8399983215332, "hands": 35.85999877929687, "on": 35.96000106811523, "testing": 36.160001831054686}, "start": 33.56666666666667, "end": 36.96666666666667},
        {"text": "Isolated. Repeatable. Easy to set up.", "spoken": "First, an isolated, repeatable environment that’s easy to set up.", "speechStart": 37.480001525878905, "speechEnd": 40.78000076293945, "wordCues": {"first": 37.480001525878905, "an": 37.67999847412109, "isolated": 38.10000045776367, "repeatable": 38.879999237060545, "environment": 39.28000076293945, "thats": 39.660001831054686, "easy": 39.980001525878905, "to": 40.17999847412109, "set": 40.379999237060545, "up": 40.49999816894531}, "start": 36.96666666666667, "end": 41.166666666666664},
