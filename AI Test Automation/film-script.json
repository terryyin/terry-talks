      "captionRanges": [
        {"text": "Large legacy system. Tickets outpace the team.", "spoken": "In a large legacy system, tickets arrive faster than your team can close them.", "speechStart": 4.420000152587891, "speechEnd": 8.300000267028809, "wordCues": {"in": 4.420000152587891, "a": 4.420000152587891, "large": 4.639999942779541, "legacy": 4.880000190734863, "system": 5.199999885559082, "tickets": 6.199999885559082, "arrive": 6.199999885559082, "faster": 6.560000019073486, "than": 7.000000076293945, "your": 7.159999923706055, "team": 7.400000171661377, "can": 7.520000057220459, "close": 7.940000133514404, "them": 7.960000114440918}, "start": 4.1, "end": 8.733333333333333},
