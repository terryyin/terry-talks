        {"text": "Confirm fixes. Explore for bugs.", "spoken": "confirm fixes, explore for bugs,", "speechStart": 45.39999969482422, "speechEnd": 47.3399983215332, "wordCues": {"confirm": 45.39999969482422, "fixes": 45.62000091552734, "explore": 46.820001678466795, "for": 46.820001678466795, "bugs": 47.3399983215332}, "start": 45.06666666666667, "end": 47.43333333333333},
        {"text": "Does known behavior still work?", "spoken": "and check that known behavior still works.", "speechStart": 47.539999084472655, "speechEnd": 49.44000061035156, "wordCues": {"and": 47.539999084472655, "check": 47.980001525878905, "that": 48.08, "known": 48.35999877929687, "behavior": 48.51999862670898, "still": 48.8399983215332, "works": 49.23999984741211}, "start": 47.43333333333333, "end": 49.733333333333334},
        {"text": "It’s a compromise.", "spoken": "It’s a compromise.", "speechStart": 50.04999989509582, "speechEnd": 50.74999994277954, "wordCues": {"its": 50.04999989509582, "a": 50.170000019073484, "compromise": 50.46999997138977}, "start": 49.733333333333334, "end": 51.1},
        {"text": "A system in panic needs relief.", "spoken": "But a system already in panic needs relief—", "speechStart": 51.47000020980835, "speechEnd": 53.74999994277954, "wordCues": {"but": 51.47000020980835, "a": 51.670000019073484, "system": 51.86999982833862, "already": 52.11000007629394, "in": 52.49000019073486, "panic": 52.99000019073486, "needs": 52.99000019073486, "relief": 53.389999809265134}, "start": 51.1, "end": 54.03333333333333},
        {"text": "No more test code to maintain.", "spoken": "not more test code to maintain.", "speechStart": 54.30999988555908, "speechEnd": 55.6299995803833, "wordCues": {"not": 54.30999988555908, "more": 54.53000015258789, "test": 54.729999961853025, "code": 54.99000019073486, "to": 55.11000007629394, "maintain": 55.6299995803833}, "start": 54.03333333333333, "end": 56.0}
