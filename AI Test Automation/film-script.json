        {"text": "AND FIX.", "spoken": "And fix.", "speechStart": 28.92000015258789, "speechEnd": 29.340000228881834, "wordCues": {"and": 28.92000015258789, "fix": 29.10000045776367}, "start": 28.633333333333333, "end": 29.666666666666668},
        {"text": "Stop adding complexity.", "spoken": "Stop adding complexity.", "speechStart": 29.97999961853027, "speechEnd": 30.97999961853027, "wordCues": {"stop": 29.97999961853027, "adding": 30.200000839233397, "complexity": 30.4599991607666}, "start": 29.666666666666668, "end": 31.366666666666667},
