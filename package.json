{
  "name": "terry-talks",
  "private": true,
  "type": "module",
  "scripts": {
    "present": "node scripts/show.mjs",
    "moves": "node scripts/moves.mjs",
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export",
    "export:pdf": "node scripts/export-pdf.mjs",
    "typecheck": "vue-tsc --noEmit",
    "terry-moves:format": "pnpm -C terry-moves format",
    "terry-moves:lint": "pnpm -C terry-moves lint",
    "root:format": "./scripts/check_root_js.sh",
    "root:lint": "./scripts/check_root_js.sh",
    "format:all": "pnpm terry-moves:format && pnpm root:format",
    "lint:all": "pnpm terry-moves:lint && pnpm root:lint",
    "format:changed": "scripts/format_changed.sh",
    "lint:changed": "scripts/lint_changed.sh"
  },
  "dependencies": {
    "@slidev/cli": "^51.0.0",
    "@slidev/theme-default": "latest"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.0"
  }
}
